    if (el.cmdPaletteInput) {
      el.cmdPaletteInput.oninput = () => renderCmdList(el.cmdPaletteInput.value);
      el.cmdPaletteInput.onkeydown = (e) => {
        if (e.key === 'Escape') { closeCmdPalette(); e.stopPropagation(); return; }
        const items = el.cmdPaletteList.querySelectorAll('.cmd-item');
        const active = el.cmdPaletteList.querySelector('.cmd-item.active');
        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
          e.preventDefault();
          const arr = [...items]; const idx = arr.indexOf(active);
          const next = e.key === 'ArrowDown' ? (idx + 1) % arr.length : (idx - 1 + arr.length) % arr.length;
          arr.forEach((it, i) => it.classList.toggle('active', i === next));
          arr[next]?.scrollIntoView({ block: 'nearest' });
        }
        if (e.key === 'Enter') { e.preventDefault(); active?.click(); }
      };
    }
    if (el.cmdPaletteOverlay) el.cmdPaletteOverlay.onclick = (e) => { if (e.target === el.cmdPaletteOverlay) closeCmdPalette(); };

    /* ── HTML Export ── */
    if (el.exportHtmlBtn) el.exportHtmlBtn.onclick = () => {
