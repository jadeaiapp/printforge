    function buildPrintHTML(d) {
      const dims = pageDimensionsMm(d.pageSize, d.orientation);
      const pxPerMm = 3.7795275591;
      const def = d.defaults || {};
      const pageBg = d.pageBgGradient?.start && d.pageBgGradient?.end ? `linear-gradient(${d.pageBgGradient.angle ?? 90}deg, ${d.pageBgGradient.start}, ${d.pageBgGradient.end})` : (d.pageBg || '#fff');
      const pageStyle = `width:${dims.wMm}mm;height:${dims.hMm}mm;background:${pageBg};position:relative;page-break-after:always;margin:0 auto 12px;box-shadow:0 2px 8px rgba(0,0,0,.1);overflow:hidden;`;
      let html = `<!DOCTYPE html><html><head><meta charset="utf-8"><title>Print</title><style>body{margin:0;padding:12px;background:#666;} .page{${pageStyle}} .node{position:absolute;font-family:Inter,sans-serif;} .p-text{white-space:pre-wrap;word-break:break-word;} .p-box{box-sizing:border-box;} .p-table{display:grid;border:1px solid #94a3b8;} .p-table>div{border:1px solid #94a3b8;} @media print{body{background:#fff;padding:0;} .page{page-break-after:always;box-shadow:none;margin:0;} .page:last-child{page-break-after:auto;}}</style></head><body>`;
      d.pages.forEach((pg) => {
        html += `<div class="page" style="${pageStyle}">`;
        [...pg.nodes].sort((a,b)=>a.z-b.z).forEach((n) => {
          if (!n.visible) return;
          const left = n.xMm; const top = n.yMm; const w = n.wMm; const h = n.hMm;
          const pos = `left:${left}mm;top:${top}mm;width:${w}mm;height:${h}mm;`;
          let inner = '';
          if (['text','heading','paragraph','datelabel'].includes(n.type)) {
            const fs = n.props.fontSize||14; const c = n.props.color||def.textColor||'#111'; const align = n.props.align||'left';
            inner = `<div class="p-text" style="font-size:${fs}px;color:${c};text-align:${align};line-height:${(n.props.lineHeight||1.3)};margin:0;">${(n.props.text||'').replace(/</g,'&lt;').replace(/\n/g,'<br>')}</div>`;
          } else if (['box','highlight','roundedrect'].includes(n.type)) {
            const fg = n.props.fillGradient;
            const fill = (fg?.start && fg?.end) ? `linear-gradient(${fg.angle ?? 90}deg, ${fg.start}, ${fg.end})` : (n.props.fill||def.fillColor||'#e2e8f0');
            const stroke = n.props.stroke||def.strokeColor||'#94a3b8'; const r = n.props.radius||0;
            inner = `<div class="p-box" style="width:100%;height:100%;background:${fill};border:1px solid ${stroke};border-radius:${r}px;"></div>`;
          } else if (n.type === 'circle') {
            const fg = n.props.fillGradient;
            const fill = (fg?.start && fg?.end) ? `linear-gradient(${fg.angle ?? 90}deg, ${fg.start}, ${fg.end})` : (n.props.fill||def.fillColor);
            const stroke = n.props.stroke||def.strokeColor;
            inner = `<div class="p-box" style="width:100%;height:100%;background:${fill};border:1px solid ${stroke};border-radius:50%;"></div>`;
          } else if (['line','divider'].includes(n.type)) {
            const th = n.props.thickness||2; const col = n.props.color||def.strokeColor||'#334155';
            inner = `<div style="position:absolute;left:0;top:50%;margin-top:-${th/2}px;height:${th}px;width:100%;background:${col};"></div>`;
          } else if (n.type === 'checkbox') {
            inner = `<span style="font-size:12px;">${n.props.checked?'☑':'☐'} ${(n.props.text||'Task').replace(/</g,'&lt;')}</span>`;
          } else if (n.type === 'checklist' || n.type === 'bulletlist') {
            const items = (n.props.items||['Item']).map((it)=>`<div>${(n.props.listStyle==='checkbox'?'☐ ':'• ')}${(it||'').replace(/</g,'&lt;')}</div>`).join('');
            inner = `<div style="font-size:12px;line-height:1.4;">${items}</div>`;
          } else if (n.type === 'table') {
            const rows = n.props.rows||3; const cols = n.props.cols||3;
            inner = `<div class="p-table" style="width:100%;height:100%;grid-template-columns:repeat(${cols},1fr);grid-template-rows:repeat(${rows},1fr);">${Array(rows*cols).fill('<div></div>').join('')}</div>`;
          } else if (n.type === 'image' && n.props.src) {
            inner = `<img src="${n.props.src}" alt="" style="width:100%;height:100%;object-fit:${n.props.objectFit||'contain'};display:block;">`;
          } else if (n.type === 'qrcode') {
            inner = `<div style="width:100%;height:100%;display:grid;place-items:center;background:#fff;padding:4px;"><img data-qr-print="${(n.props.qrText||'').replace(/"/g,'&quot;')}" style="max-width:100%;max-height:100%;" alt="QR"/></div>`;
          } else if (n.type === 'progressbar') {
            const val = Math.max(0, Math.min(100, n.props.progressValue ?? 50));
            const tk = n.props.progressTrack||'#e2e8f0'; const br = n.props.progressBar||'#6366f1';
            inner = `<div style="width:100%;height:100%;display:flex;align-items:center"><div style="width:100%;height:100%;border-radius:999px;overflow:hidden;background:${tk};position:relative"><div style="height:100%;width:${val}%;background:${br};border-radius:999px;"></div><div style="position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:600;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.3)">${val}%</div></div></div>`;
          } else if (n.type === 'star') {
            const pts = n.props.points || 5; const ir = n.props.innerRadius || 0.45;
            const fill = n.props.fill || '#fbbf24'; const stroke = n.props.stroke || '#d97706';
            inner = `<svg viewBox="0 0 100 100" style="width:100%;height:100%;"><polygon points="${starPoints(50,50,48,pts,ir)}" fill="${fill}" stroke="${stroke}" stroke-width="2"/></svg>`;
          } else if (n.type === 'stickynote') {
            const bg = n.props.noteBg || '#fef08a'; const fs = n.props.fontSize || 14;
            inner = `<div style="width:100%;height:100%;background:${bg};padding:8px 10px;border-radius:2px;box-shadow:2px 3px 8px rgba(0,0,0,.1);font-size:${fs}px;color:#1c1917;white-space:pre-wrap;word-break:break-word;">${(n.props.text||'').replace(/</g,'&lt;')}</div>`;
          } else if (n.type === 'ruler') {
            const col = '#dc2626';
            inner = `<div style="width:100%;height:100%;position:relative;display:flex;align-items:center;"><div style="width:100%;height:2px;background:${col};"></div><span style="position:absolute;top:0;left:50%;transform:translateX(-50%);font-size:9px;font-weight:600;color:${col};white-space:nowrap;">${n.wMm.toFixed(1)} mm</span></div>`;
          } else if (n.type === 'rating') {
            const val = n.props.ratingValue ?? 3; const max = n.props.ratingMax ?? 5; const color = n.props.ratingColor || '#f59e0b';
            const icons = { star: ['★','☆'], heart: ['♥','♡'], circle: ['●','○'] };
            const [filled, unfilled] = icons[n.props.ratingIcon || 'star'] || icons.star;
            let stars = ''; for (let i = 1; i <= max; i++) stars += `<span style="color:${i <= val ? color : '#d1d5db'};font-size:18px">${i <= val ? filled : unfilled}</span>`;
            inner = `<div style="display:flex;align-items:center;gap:2px">${stars}</div>`;
          } else if (n.type === 'signature') {
            inner = `<div style="width:100%;height:100%;display:flex;flex-direction:column;justify-content:flex-end;padding:4px 8px"><div style="border-bottom:2px solid #374151;margin-bottom:4px"></div><span style="font-size:10px;color:#6b7280">${(n.props.signatureLabel||'Signature').replace(/</g,'&lt;')}</span></div>`;
          } else if (n.type === 'barcode') {
            inner = `<div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;background:#fff;padding:4px"><div style="display:flex;gap:1px;height:60%;align-items:flex-end">${(n.props.barcodeText||'123456789').split('').map((_,i)=>`<div style="width:${2+i%3}px;height:${60+i*2%20}%;background:#000"></div>`).join('')}</div><span style="font-size:10px;margin-top:4px;font-family:monospace">${(n.props.barcodeText||'123456789').replace(/</g,'&lt;')}</span></div>`;
          } else if (n.type === 'chart') {
            const data = (n.props.chartData||'10,30,20,50,40').split(',').map(Number); const max = Math.max(...data,1); const color = n.props.chartColors||'#6366f1';
            const bars = data.map((v,i)=>`<div style="width:${100/data.length}%;height:${(v/max)*100}%;background:${color};border-radius:2px 2px 0 0"></div>`).join('');
            inner = `<div style="width:100%;height:100%;display:flex;align-items:flex-end;gap:2px;padding:4px">${bars}</div>`;
          } else if (n.type === 'timeline') {
            let items = []; try { items = JSON.parse(n.props.timelineItems||'[]'); } catch{}
            if(!items.length) items = [{date:'2026',title:'Event'}];
            const color = n.props.fill||'#6366f1';
            const html = items.map(it=>`<div style="display:flex;gap:8px;margin-bottom:8px"><div style="width:8px;height:8px;border-radius:50%;background:${color};margin-top:4px;flex-shrink:0"></div><div><strong style="font-size:11px">${it.date||''}</strong><br><span style="font-size:10px;color:#64748b">${it.title||''}</span></div></div>`).join('');
            inner = `<div style="padding:4px">${html}</div>`;
          } else if (n.type === 'countdown') {
            const target = n.props.countdownTarget || new Date(Date.now()+86400000*30).toISOString().slice(0,10);
            const diff = Math.max(0, Math.ceil((new Date(target).getTime()-Date.now())/86400000));
            const color = n.props.fill||'#6366f1';
            inner = `<div style="width:100%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center"><span style="font-size:28px;font-weight:700;color:${color}">${diff}</span><span style="font-size:11px;color:#64748b">${(n.props.countdownLabel||'Days left').replace(/</g,'&lt;')}</span></div>`;
          } else { inner = '<div style="width:100%;height:100%;background:#f1f5f9;"></div>'; }
          html += `<div class="node" style="${pos}">${inner}</div>`;
        });
        html += '</div>';
      });
      html += '</body></html>';
      return html;
    }
