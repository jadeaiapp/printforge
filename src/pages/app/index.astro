    if (el.themePageGradientEnd) el.themePageGradientEnd.onchange = () => { if (doc.pageBgGradient) { doc.pageBgGradient.end = el.themePageGradientEnd.value; addRecentColor(el.themePageGradientEnd.value); commitChange(); render(); } };
