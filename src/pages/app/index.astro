    function closePresentation() { presOverlay.hidden = true; }
    el.presentationBtn.onclick = () => { openPresentation(); closeTransientOverlays(); };
    document.getElementById('presentation-prev').onclick = () => { presPageIdx = Math.max(0, presPageIdx - 1); renderPresPage(); };
    document.getElementById('presentation-next').onclick = () => { presPageIdx = Math.min(doc.pages.length - 1, presPageIdx + 1); renderPresPage(); };
    presOverlay.addEventListener('keydown', (e) => {
