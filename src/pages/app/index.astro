    window.addEventListener('keydown', (e) => {
      const active = document.activeElement;
      const typing = active && (active.matches('input,textarea,select') || active.isContentEditable);
      const mod = e.ctrlKey || e.metaKey;

      if (typing && mod && e.key.toLowerCase() === 'z') return;

      if (mod && e.key.toLowerCase() === 'z') {
        e.preventDefault();
        if (e.shiftKey) {
          if (!redoStack.length) return;
          const next = redoStack.pop();
          undoStack.push(structuredClone(next));
          doc = structuredClone(next);
        } else {
          if (undoStack.length <= 1) return;
          const current = undoStack.pop();
          redoStack.push(structuredClone(current));
          doc = structuredClone(undoStack[undoStack.length - 1]);
        }
        setPrimarySelection(null);
        dirty = true;
        setSaveIndicator();
        autosaveSchedule();
        render();
        return;
      }

      if (mod && e.key.toLowerCase() === 'g') {
        e.preventDefault();
        if (e.shiftKey) ungroupSelection();
        else groupSelection();
        return;
      }

      if (mod && e.key.toLowerCase() === 'd') {
        e.preventDefault();
        if (selectedNodeIds.size) {
          const ids = [...selectedNodeIds];
          ids.forEach((id) => duplicateNode(id));
          if (ids.length === 1) showToast(labels.contextDuplicate);
        }
        return;
      }

      if (e.key === 'Escape') {
        if (!presOverlay.hidden) { closePresentation(); return; }
        if (!onbOverlay.hidden) { closeOnboarding(); return; }
        const shortcutsEl = document.getElementById('shortcuts-overlay');
        if (shortcutsEl && !shortcutsEl.hidden) { shortcutsEl.hidden = true; focusCanvas(); return; }
        const tipsEl = document.getElementById('tips-overlay');
        if (tipsEl && !tipsEl.hidden) { tipsEl.hidden = true; focusCanvas(); return; }
        if (!el.templateModal.hidden) { closeTemplateModal(); focusCanvas(); return; }
        if (!el.contextMenu.hidden) { closeContextMenu(); focusCanvas(); return; }
        const hadOverlay = el.fileMenu.open || el.toast.classList.contains('show');
        closeTransientOverlays();
        if (!hadOverlay) {
          setPrimarySelection(null);
          render();
        }
        focusCanvas();
        return;
      }
      if (!typing && e.code === 'Space') {
        spacePanKeyDown = true;
        e.preventDefault();
      }
      if (typing) return;
      if (e.key === 'Delete' && selectedNodeIds.size) {
        e.preventDefault();
        deleteSelectedNodes();
      }
    });

    window.addEventListener('keyup', (e) => {
      if (e.code === 'Space') spacePanKeyDown = false;
    });

    if (import.meta.env.DEV) {
      const validationResults = validateTemplates();
      const failed = validationResults.filter((item) => !item.ok);
      console.info('[templates] validation summary', { total: validationResults.length, failed: failed.length });
      if (failed.length) console.warn('[templates] validation failures', failed);
    }

    /* ── Command Palette (Ctrl+K) ── */
    const cmdCommands = [
      { id: 'add-text', label: labels.cmdAddText, icon: '🅣', action: () => createPreset('text', 30, 30) },
      { id: 'add-heading', label: 'Add heading', icon: 'Ⓗ', action: () => createPreset('heading', 30, 30) },
      { id: 'add-image', label: labels.cmdAddImage, icon: '🖼', action: () => addImageAt(30, 30) },
      { id: 'add-box', label: 'Add box', icon: '⬚', action: () => createPreset('box', 30, 30) },
      { id: 'add-chart', label: labels.chart, icon: '📊', action: () => createPreset('chart', 30, 30) },
      { id: 'add-rating', label: labels.rating, icon: '⭐', action: () => createPreset('rating', 30, 30) },
      { id: 'add-timeline', label: labels.timeline, icon: '⏳', action: () => createPreset('timeline', 30, 30) },
      { id: 'add-countdown', label: labels.countdown, icon: '⏱', action: () => createPreset('countdown', 30, 30) },
      { id: 'export-pdf', label: labels.cmdExportPdf, icon: '📄', action: () => el.exportPdf.click() },
      { id: 'export-png', label: labels.cmdExportPng, icon: '🖼', action: () => el.exportPng.click() },
      { id: 'export-html', label: labels.exportHtml, icon: '🌐', action: () => el.exportHtmlBtn.click() },
      { id: 'save', label: labels.cmdSave, icon: '💾', action: () => el.save.click() },
      { id: 'dark-mode', label: labels.cmdDarkMode, icon: '🌙', action: () => { el.darkModeToggle.checked = !el.darkModeToggle.checked; el.darkModeToggle.onchange(); } },
      { id: 'new-page', label: labels.cmdNewPage, icon: '+', action: () => el.addPage.click() },
      { id: 'undo', label: labels.cmdUndo, icon: '↩', action: () => { document.dispatchEvent(new KeyboardEvent('keydown', { key: 'z', ctrlKey: true })); } },
      { id: 'redo', label: labels.cmdRedo, icon: '↪', action: () => { document.dispatchEvent(new KeyboardEvent('keydown', { key: 'z', ctrlKey: true, shiftKey: true })); } },
      { id: 'presentation', label: labels.presentationMode, icon: '🖥', action: () => el.presentationBtn.click() },
      { id: 'history', label: labels.historyTimeline, icon: '🕐', action: () => openHistory() },
    ];
    function openCmdPalette() {
      if (!el.cmdPaletteOverlay) return;
      el.cmdPaletteOverlay.hidden = false;
      el.cmdPaletteInput.value = '';
      renderCmdList('');
      setTimeout(() => el.cmdPaletteInput.focus(), 50);
    }
    function closeCmdPalette() { if (el.cmdPaletteOverlay) el.cmdPaletteOverlay.hidden = true; }
    function renderCmdList(query) {
      const q = query.toLowerCase().trim();
      const filtered = q ? cmdCommands.filter(c => c.label.toLowerCase().includes(q) || c.id.includes(q)) : cmdCommands;
      el.cmdPaletteList.innerHTML = filtered.map((c, i) => `<button class="cmd-item${i === 0 ? ' active' : ''}" data-cmd-idx="${i}">${c.icon} ${c.label}</button>`).join('');
