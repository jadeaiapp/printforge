    if (el.printProfileSelect) { el.printProfileSelect.onchange = updatePrintProfile; updatePrintProfile(); }

    /* ── PPTX Export (basic HTML-based) ── */
    if (el.exportPptxBtn) el.exportPptxBtn.onclick = async () => {
      showToast(labels.toastZipGenerating);
      closeTransientOverlays();
      try {
        const zip = new JSZip();
        const dims = pageDimensionsMm(doc.pageSize, doc.orientation);
        const emu = (mm) => Math.round(mm * 914400 / 25.4);
        const slideW = emu(dims.wMm); const slideH = emu(dims.hMm);
        let slidesXml = '';
        let relsXml = '';
        doc.pages.forEach((pg, idx) => {
          const slideNum = idx + 1;
          let shapes = '';
          [...pg.nodes].sort((a,b) => a.z - b.z).forEach((n, si) => {
            if (!n.visible) return;
            const x = emu(n.xMm); const y = emu(n.yMm); const w = emu(n.wMm); const h = emu(n.hMm);
            let text = '';
            if (['text','heading','paragraph','datelabel'].includes(n.type)) text = (n.props.text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;');
            else if (n.type === 'stickynote') text = (n.props.text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;');
            const fs = (n.props.fontSize || 14) * 100;
            shapes += `<p:sp><p:nvSpPr><p:cNvPr id="${si+2}" name="${n.name}"/><p:cNvSpPr/><p:nvPr/></p:nvSpPr><p:spPr><a:xfrm><a:off x="${x}" y="${y}"/><a:ext cx="${w}" cy="${h}"/></a:xfrm><a:prstGeom prst="rect"><a:avLst/></a:prstGeom></p:spPr><p:txBody><a:bodyPr/><a:lstStyle/><a:p><a:r><a:rPr lang="en-US" sz="${fs}" dirty="0"/><a:t>${text}</a:t></a:r></a:p></p:txBody></p:sp>`;
          });
          const slideContent = `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:sld xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr><a:xfrm><a:off x="0" y="0"/><a:ext cx="${slideW}" cy="${slideH}"/><a:chOff x="0" y="0"/><a:chExt cx="${slideW}" cy="${slideH}"/></a:xfrm></p:grpSpPr>${shapes}</p:spTree></p:cSld></p:sld>`;
          zip.file(`ppt/slides/slide${slideNum}.xml`, slideContent);
          zip.file(`ppt/slides/_rels/slide${slideNum}.xml.rels`, `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout" Target="../slideLayouts/slideLayout1.xml"/></Relationships>`);
          slidesXml += `<p:sldIdLst><p:sldId id="${256+idx}" r:id="rId${idx+2}"/></p:sldIdLst>`;
          relsXml += `<Relationship Id="rId${idx+2}" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slide" Target="slides/slide${slideNum}.xml"/>`;
        });
        zip.file('[Content_Types].xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Types xmlns="http://schemas.openxmlformats.org/package/2006/content-types"><Default Extension="xml" ContentType="application/xml"/><Default Extension="rels" ContentType="application/vnd.openxmlformats-package.relationships+xml"/><Override PartName="/ppt/presentation.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.presentation.main+xml"/>${doc.pages.map((_,i) => `<Override PartName="/ppt/slides/slide${i+1}.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slide+xml"/>`).join('')}<Override PartName="/ppt/slideLayouts/slideLayout1.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slideLayout+xml"/><Override PartName="/ppt/slideMasters/slideMaster1.xml" ContentType="application/vnd.openxmlformats-officedocument.presentationml.slideMaster+xml"/></Types>`);
        zip.file('_rels/.rels', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/officeDocument" Target="ppt/presentation.xml"/></Relationships>`);
        zip.file('ppt/presentation.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:presentation xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:sldMasterIdLst><p:sldMasterId id="2147483648" r:id="rId1"/></p:sldMasterIdLst>${slidesXml}<p:sldSz cx="${slideW}" cy="${slideH}"/><p:notesSz cx="${slideW}" cy="${slideH}"/></p:presentation>`);
        zip.file('ppt/_rels/presentation.xml.rels', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster" Target="slideMasters/slideMaster1.xml"/>${relsXml}</Relationships>`);
        zip.file('ppt/slideMasters/slideMaster1.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:sldMaster xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main"><p:cSld><p:bg><p:bgPr><a:solidFill><a:srgbClr val="FFFFFF"/></a:solidFill><a:effectLst/></p:bgPr></p:bg><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/></p:spTree></p:cSld><p:sldLayoutIdLst><p:sldLayoutId id="2147483649" r:id="rId1"/></p:sldLayoutIdLst></p:sldMaster>`);
        zip.file('ppt/slideMasters/_rels/slideMaster1.xml.rels', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideLayout" Target="../slideLayouts/slideLayout1.xml"/></Relationships>`);
        zip.file('ppt/slideLayouts/slideLayout1.xml', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><p:sldLayout xmlns:a="http://schemas.openxmlformats.org/drawingml/2006/main" xmlns:r="http://schemas.openxmlformats.org/officeDocument/2006/relationships" xmlns:p="http://schemas.openxmlformats.org/presentationml/2006/main" type="blank"><p:cSld name="Blank"><p:spTree><p:nvGrpSpPr><p:cNvPr id="1" name=""/><p:cNvGrpSpPr/><p:nvPr/></p:nvGrpSpPr><p:grpSpPr/></p:spTree></p:cSld></p:sldLayout>`);
        zip.file('ppt/slideLayouts/_rels/slideLayout1.xml.rels', `<?xml version="1.0" encoding="UTF-8" standalone="yes"?><Relationships xmlns="http://schemas.openxmlformats.org/package/2006/relationships"><Relationship Id="rId1" Type="http://schemas.openxmlformats.org/officeDocument/2006/relationships/slideMaster" Target="../slideMasters/slideMaster1.xml"/></Relationships>`);
        const blob = await zip.generateAsync({ type: 'blob' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = url; a.download = `printforge-${Date.now()}.pptx`; a.click();
        URL.revokeObjectURL(url);
        showToast('PPTX downloaded');
      } catch(e) { console.error(e); showToast('PPTX export failed'); }
    };

    /* ── Spread View ── */
    function openSpreadView() {
      if (!el.spreadOverlay || !el.spreadPages) return;
      el.spreadOverlay.hidden = false;
      const dims = pageDimensionsMm(doc.pageSize, doc.orientation);
      el.spreadPages.innerHTML = '';
      doc.pages.forEach((pg, idx) => {
        const container = document.createElement('div');
        container.className = 'spread-page-wrap';
        container.innerHTML = `<div class="spread-page-label">Page ${idx + 1}: ${pg.name}</div>`;
        const canvas = document.createElement('canvas');
        const scale = 0.4;
        canvas.width = mmToPx(dims.wMm) * scale;
        canvas.height = mmToPx(dims.hMm) * scale;
        canvas.className = 'spread-page-canvas';
        const ctx = canvas.getContext('2d');
        ctx.scale(scale, scale);
        ctx.fillStyle = doc.pageBg || '#fff';
        ctx.fillRect(0, 0, mmToPx(dims.wMm), mmToPx(dims.hMm));
        [...pg.nodes].sort((a,b) => a.z - b.z).forEach(n => {
          if (!n.visible) return;
          const x = mmToPx(n.xMm); const y = mmToPx(n.yMm); const w = mmToPx(n.wMm); const h = mmToPx(n.hMm);
          if (['box','highlight','roundedrect','circle'].includes(n.type)) { ctx.fillStyle = n.props.fill || '#e2e8f0'; ctx.fillRect(x, y, w, h); }
          else if (['text','heading','paragraph','datelabel'].includes(n.type)) { ctx.fillStyle = n.props.color || '#111'; ctx.font = `${n.props.fontSize || 14}px sans-serif`; ctx.fillText((n.props.text || '').substring(0, 30), x, y + (n.props.fontSize || 14)); }
          else { ctx.fillStyle = '#f1f5f9'; ctx.fillRect(x, y, w, h); ctx.strokeStyle = '#d1d5db'; ctx.strokeRect(x, y, w, h); }
        });
        container.appendChild(canvas);
        container.onclick = () => { doc.activePageId = pg.id; el.spreadOverlay.hidden = true; render(); };
        el.spreadPages.appendChild(container);
      });
    }
    if (el.spreadClose) el.spreadClose.onclick = () => { el.spreadOverlay.hidden = true; };

    /* ── Accessibility Checker ── */
    function luminance(hex) {
      const r = parseInt(hex.slice(1, 3), 16) / 255; const g = parseInt(hex.slice(3, 5), 16) / 255; const b = parseInt(hex.slice(5, 7), 16) / 255;
      const sR = r <= 0.03928 ? r / 12.92 : Math.pow((r + 0.055) / 1.055, 2.4);
      const sG = g <= 0.03928 ? g / 12.92 : Math.pow((g + 0.055) / 1.055, 2.4);
      const sB = b <= 0.03928 ? b / 12.92 : Math.pow((b + 0.055) / 1.055, 2.4);
      return 0.2126 * sR + 0.7152 * sG + 0.0722 * sB;
    }
    function contrastRatio(hex1, hex2) {
      const l1 = luminance(hex1); const l2 = luminance(hex2);
      const lighter = Math.max(l1, l2); const darker = Math.min(l1, l2);
      return (lighter + 0.05) / (darker + 0.05);
    }
    function runA11yCheck() {
      if (!el.a11yPanel || !el.a11yResults) return;
      el.a11yPanel.hidden = false;
      const p = activePage(); if (!p) { el.a11yResults.innerHTML = '<p>No active page</p>'; return; }
      const bg = doc.pageBg || '#ffffff';
      let html = '';
      let issues = 0;
      p.nodes.forEach(n => {
        if (!n.visible) return;
        if (['text', 'heading', 'paragraph', 'datelabel'].includes(n.type)) {
          const color = n.props.color || '#111827';
          const ratio = contrastRatio(color, bg);
          const pass = ratio >= 4.5;
          if (!pass) issues++;
          html += `<div class="a11y-item ${pass ? 'pass' : 'fail'}"><strong>${n.name}</strong>: ${ratio.toFixed(1)}:1 ${pass ? labels.contrastPass : labels.contrastFail}<br><span style="color:${color}">■</span> on <span style="color:${bg};background:${bg};border:1px solid #ccc">■</span>${n.props.fontSize && n.props.fontSize < 12 ? ' ⚠ Small font' : ''}</div>`;
        }
      });
      if (!html) html = '<p class="a11y-pass-all">All elements pass accessibility checks!</p>';
      else html = `<p class="a11y-summary">${issues} issue${issues !== 1 ? 's' : ''} found</p>` + html;
      el.a11yResults.innerHTML = html;
    }
    if (el.a11yClose) el.a11yClose.onclick = () => { el.a11yPanel.hidden = true; };

    /* ── Auto Placement Suggestions ── */
    function suggestPlacement(node) {
      if (!node) return;
      const d = dims();
      const centerX = (d.wMm - node.wMm) / 2;
      const centerY = (d.hMm - node.hMm) / 2;
      if (Math.abs(node.xMm - centerX) < 5) node.xMm = centerX;
      if (Math.abs(node.yMm - centerY) < 5) node.yMm = centerY;
    }

    /* Add spread + a11y to command palette */
    cmdCommands.push(
      { id: 'spread', label: 'Spread view', icon: '📖', action: () => openSpreadView() },
      { id: 'a11y', label: 'Accessibility check', icon: '♿', action: () => runA11yCheck() }
    );

    /* Escape closes new panels */
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && el.cmdPaletteOverlay && !el.cmdPaletteOverlay.hidden) { closeCmdPalette(); e.stopPropagation(); }
      if (e.key === 'Escape' && el.historyPanel && !el.historyPanel.hidden) { el.historyPanel.hidden = true; }
      if (e.key === 'Escape' && el.batchModal && !el.batchModal.hidden) { el.batchModal.hidden = true; }
      if (e.key === 'Escape' && el.spreadOverlay && !el.spreadOverlay.hidden) { el.spreadOverlay.hidden = true; }
      if (e.key === 'Escape' && el.a11yPanel && !el.a11yPanel.hidden) { el.a11yPanel.hidden = true; }
    }, true);

    renderAssets();
    switchThemeSubtab('page');
    renderRecentProjects();
    render();
    const hasSavedDoc = !!localStorage.getItem(DOC_STORAGE_KEY);
    if (!hasSavedDoc && localStorage.getItem(TEMPLATE_HIDE_KEY) !== '1') openTemplateModal();
    if (!localStorage.getItem(ONBOARDING_KEY)) { renderOnboarding(); onbOverlay.hidden = false; }
    focusCanvas();
    window.addEventListener('beforeunload', () => saveToLocal(doc));
  </script>
</BaseLayout>
