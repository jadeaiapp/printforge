    /* ── SVG Export ── */
    function buildSvgForPage(pg, dims) {
      const pxPerMm = 3.7795275591;
      const def = doc.defaults || {};
      const pageBg = doc.pageBgGradient?.start && doc.pageBgGradient?.end
        ? `url(#pgGrad)` : (doc.pageBg || '#fff');
      let defs = '';
      if (doc.pageBgGradient?.start && doc.pageBgGradient?.end) {
        const a = (doc.pageBgGradient.angle ?? 90) * Math.PI / 180;
        const x1 = 50 - 50 * Math.cos(a); const y1 = 50 - 50 * Math.sin(a);
        const x2 = 50 + 50 * Math.cos(a); const y2 = 50 + 50 * Math.sin(a);
        defs += `<linearGradient id="pgGrad" x1="${x1}%" y1="${y1}%" x2="${x2}%" y2="${y2}%"><stop offset="0%" stop-color="${doc.pageBgGradient.start}"/><stop offset="100%" stop-color="${doc.pageBgGradient.end}"/></linearGradient>`;
      }
      let svgContent = `<rect width="${dims.wMm}mm" height="${dims.hMm}mm" fill="${pageBg}"/>`;
      [...pg.nodes].sort((a,b)=>a.z-b.z).forEach((n) => {
        if (!n.visible) return;
        const x = n.xMm; const y = n.yMm; const w = n.wMm; const h = n.hMm;
        if (['text','heading','paragraph','datelabel'].includes(n.type)) {
          const fs = n.props.fontSize||14; const c = n.props.color||def.textColor||'#111';
          const lines = (n.props.text||'').split('\n');
          let textSvg = `<text x="${x}mm" y="${y + fs * 0.35}mm" font-size="${fs}" fill="${c}" font-family="${n.props.fontFamily||'Inter,sans-serif'}" font-weight="${n.props.fontWeight||400}">`;
          lines.forEach((line, i) => { textSvg += `<tspan x="${x}mm" dy="${i === 0 ? 0 : fs * 1.3}">${line.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</tspan>`; });
          textSvg += '</text>';
          svgContent += textSvg;
        } else if (['box','highlight','roundedrect'].includes(n.type)) {
          const fg = n.props.fillGradient;
          const fill = (fg?.start && fg?.end) ? fg.start : (n.props.fill||def.fillColor||'#e2e8f0');
          const stroke = n.props.stroke||def.strokeColor||'#94a3b8';
          const r = n.props.radius||0;
          svgContent += `<rect x="${x}mm" y="${y}mm" width="${w}mm" height="${h}mm" rx="${r}" fill="${fill}" stroke="${stroke}" stroke-width="1"/>`;
        } else if (n.type === 'circle') {
          const fg = n.props.fillGradient;
          const fill = (fg?.start && fg?.end) ? fg.start : (n.props.fill||def.fillColor);
          const stroke = n.props.stroke||def.strokeColor;
          svgContent += `<ellipse cx="${x + w/2}mm" cy="${y + h/2}mm" rx="${w/2}mm" ry="${h/2}mm" fill="${fill}" stroke="${stroke}" stroke-width="1"/>`;
        } else if (['line','divider'].includes(n.type)) {
          const col = n.props.color||def.strokeColor||'#334155'; const th = n.props.thickness||2;
          svgContent += `<line x1="${x}mm" y1="${y + h/2}mm" x2="${x+w}mm" y2="${y + h/2}mm" stroke="${col}" stroke-width="${th}"/>`;
        } else if (n.type === 'progressbar') {
          const val = Math.max(0, Math.min(100, n.props.progressValue ?? 50));
          const tk = n.props.progressTrack||'#e2e8f0'; const br = n.props.progressBar||'#6366f1';
          svgContent += `<rect x="${x}mm" y="${y}mm" width="${w}mm" height="${h}mm" rx="${h/2}mm" fill="${tk}"/>`;
          svgContent += `<rect x="${x}mm" y="${y}mm" width="${w * val / 100}mm" height="${h}mm" rx="${h/2}mm" fill="${br}"/>`;
        } else if (n.type === 'star') {
          const pts = n.props.points || 5; const ir = n.props.innerRadius || 0.45;
          const fill = n.props.fill || '#fbbf24'; const stroke = n.props.stroke || '#d97706';
          const r = Math.min(w, h) / 2;
          const cx = x + w / 2; const cy = y + h / 2;
          const angle = Math.PI / pts; const ri = r * ir;
          const coords = [];
          for (let i = 0; i < pts * 2; i++) {
            const a = i * angle - Math.PI / 2;
            const rad = i % 2 === 0 ? r : ri;
            coords.push(`${(cx + Math.cos(a) * rad).toFixed(2)},${(cy + Math.sin(a) * rad).toFixed(2)}`);
          }
          svgContent += `<polygon points="${coords.join(' ')}" fill="${fill}" stroke="${stroke}" stroke-width="2"/>`;
        } else if (n.type === 'stickynote') {
          const bg = n.props.noteBg || '#fef08a';
          svgContent += `<rect x="${x}mm" y="${y}mm" width="${w}mm" height="${h}mm" rx="2" fill="${bg}"/>`;
          const text = (n.props.text || '').trim();
          if (text) {
            const fs = n.props.fontSize || 14;
            svgContent += `<text x="${x + 3}mm" y="${y + fs * 0.4 + 3}mm" font-size="${fs}" fill="#1c1917" font-family="Inter,sans-serif">${text.replace(/&/g,'&amp;').replace(/</g,'&lt;')}</text>`;
          }
        } else if (n.type === 'ruler') {
          svgContent += `<line x1="${x}mm" y1="${y + h/2}mm" x2="${x+w}mm" y2="${y + h/2}mm" stroke="#dc2626" stroke-width="2"/>`;
          svgContent += `<text x="${x + w/2}mm" y="${y + h/2 - 2}mm" text-anchor="middle" font-size="8" fill="#dc2626" font-weight="600">${w.toFixed(1)} mm</text>`;
        } else if (n.type === 'rating') {
          const val = n.props.ratingValue ?? 3; const max = n.props.ratingMax ?? 5; const color = n.props.ratingColor || '#f59e0b';
          for (let i = 0; i < max; i++) {
            svgContent += `<text x="${x + i * (w/max)}mm" y="${y + h * 0.75}mm" font-size="${Math.min(h * 2, 20)}" fill="${i < val ? color : '#d1d5db'}">★</text>`;
          }
        } else if (n.type === 'signature') {
          svgContent += `<line x1="${x + 2}mm" y1="${y + h * 0.7}mm" x2="${x + w - 2}mm" y2="${y + h * 0.7}mm" stroke="#374151" stroke-width="1.5"/>`;
          svgContent += `<text x="${x + 2}mm" y="${y + h - 1}mm" font-size="8" fill="#6b7280">${(n.props.signatureLabel || 'Signature').replace(/&/g,'&amp;').replace(/</g,'&lt;')}</text>`;
        } else if (n.type === 'barcode') {
          svgContent += `<rect x="${x}mm" y="${y}mm" width="${w}mm" height="${h}mm" fill="#fff" stroke="#e5e7eb"/>`;
          svgContent += `<text x="${x + w/2}mm" y="${y + h - 2}mm" text-anchor="middle" font-size="8" fill="#000" font-family="monospace">${(n.props.barcodeText || '').replace(/&/g,'&amp;').replace(/</g,'&lt;')}</text>`;
        } else if (n.type === 'chart') {
          const data = (n.props.chartData||'10,30,20,50,40').split(',').map(Number); const max = Math.max(...data,1); const color = n.props.chartColors||'#6366f1';
          data.forEach((v,i) => {
            const bw = w / data.length * 0.8; const bx = x + i * (w / data.length) + (w / data.length * 0.1);
            const bh = (v / max) * h; const by = y + h - bh;
            svgContent += `<rect x="${bx}mm" y="${by}mm" width="${bw}mm" height="${bh}mm" fill="${color}" rx="1"/>`;
          });
        } else if (n.type === 'timeline') {
          let items = []; try { items = JSON.parse(n.props.timelineItems||'[]'); } catch{}
          if(!items.length) items = [{date:'2026',title:'Event'}];
          const color = n.props.fill||'#6366f1';
          items.forEach((it, i) => {
            const iy = y + i * (h / items.length) + 8;
            svgContent += `<circle cx="${x + 4}mm" cy="${iy}mm" r="3" fill="${color}"/>`;
            svgContent += `<text x="${x + 10}mm" y="${iy + 1}mm" font-size="9" fill="#111" font-weight="600">${(it.date||'').replace(/&/g,'&amp;').replace(/</g,'&lt;')}</text>`;
            svgContent += `<text x="${x + 10}mm" y="${iy + 5}mm" font-size="8" fill="#64748b">${(it.title||'').replace(/&/g,'&amp;').replace(/</g,'&lt;')}</text>`;
          });
        } else if (n.type === 'countdown') {
          const target = n.props.countdownTarget || new Date(Date.now()+86400000*30).toISOString().slice(0,10);
          const diff = Math.max(0, Math.ceil((new Date(target).getTime()-Date.now())/86400000));
          const color = n.props.fill||'#6366f1';
          svgContent += `<text x="${x + w/2}mm" y="${y + h * 0.55}mm" text-anchor="middle" font-size="22" fill="${color}" font-weight="700">${diff}</text>`;
          svgContent += `<text x="${x + w/2}mm" y="${y + h * 0.8}mm" text-anchor="middle" font-size="9" fill="#64748b">${(n.props.countdownLabel||'').replace(/&/g,'&amp;').replace(/</g,'&lt;')}</text>`;
        }
      });
      return `<?xml version="1.0" encoding="UTF-8"?><svg xmlns="http://www.w3.org/2000/svg" width="${dims.wMm}mm" height="${dims.hMm}mm" viewBox="0 0 ${dims.wMm} ${dims.hMm}">${defs ? `<defs>${defs}</defs>` : ''}${svgContent}</svg>`;
    }
    el.exportSvg.onclick = () => {
