    let presPageIdx = 0;
    function renderPresPage() {
      const dims = pageDimensionsMm(doc.pageSize, doc.orientation);
      const pxPerMm = 3.7795275591;
      const pg = doc.pages[presPageIdx];
      if (!pg) return;
      presIndicator.textContent = `${presPageIdx + 1} / ${doc.pages.length}`;
      const maxW = presStage.clientWidth - 48;
      const maxH = presStage.clientHeight - 48;
      const pageWPx = dims.wMm * pxPerMm; const pageHPx = dims.hMm * pxPerMm;
      const scale = Math.min(maxW / pageWPx, maxH / pageHPx, 1.5);
      presStage.innerHTML = '';
      const pageDiv = document.createElement('div');
      pageDiv.className = 'presentation-page';
      pageDiv.style.width = `${pageWPx}px`;
      pageDiv.style.height = `${pageHPx}px`;
      pageDiv.style.transform = `scale(${scale})`;
      pageDiv.style.transformOrigin = 'center center';
      const pageBg = doc.pageBgGradient?.start && doc.pageBgGradient?.end
        ? `linear-gradient(${doc.pageBgGradient.angle ?? 90}deg, ${doc.pageBgGradient.start}, ${doc.pageBgGradient.end})`
        : (doc.pageBg || '#fff');
      pageDiv.style.background = pageBg;
      [...pg.nodes].sort((a,b)=>a.z-b.z).forEach((n) => {
        if (!n.visible) return;
        const nd = document.createElement('div');
        nd.style.cssText = `position:absolute;left:${mmToPx(n.xMm)}px;top:${mmToPx(n.yMm)}px;width:${mmToPx(n.wMm)}px;height:${mmToPx(n.hMm)}px;z-index:${n.z};`;
        if (n.props.boxShadow) nd.style.boxShadow = n.props.boxShadow;
        nd.innerHTML = nodeHtml(n);
        const editable = nd.querySelector('[contenteditable]');
        if (editable) editable.removeAttribute('contenteditable');
        pageDiv.appendChild(nd);
      });
      presStage.appendChild(pageDiv);
    }
    function openPresentation() {
      presPageIdx = doc.pages.findIndex(p => p.id === doc.activePageId);
      if (presPageIdx < 0) presPageIdx = 0;
      presOverlay.hidden = false;
