    /* ── Batch Export (Mail Merge) ── */
    let batchCsvData = [];
    if (el.batchExportBtn) el.batchExportBtn.onclick = () => { el.batchModal.hidden = false; closeTransientOverlays(); };
    if (el.batchCloseBtn) el.batchCloseBtn.onclick = () => { el.batchModal.hidden = true; };
    if (el.batchCsvInput) el.batchCsvInput.onchange = async () => {
      const file = el.batchCsvInput.files?.[0]; if (!file) return;
      const text = await file.text();
      const lines = text.split('\n').map(l => l.split(',').map(c => c.trim()));
      const headers = lines[0] || [];
      batchCsvData = lines.slice(1).filter(r => r.length >= headers.length).map(r => {
        const obj = {}; headers.forEach((h, i) => obj[h] = r[i] || ''); return obj;
      });
      el.batchPreview.innerHTML = `<strong>${batchCsvData.length} rows</strong><br>Columns: ${headers.join(', ')}`;
    };
    if (el.batchGenerateBtn) el.batchGenerateBtn.onclick = async () => {
      if (!batchCsvData.length) { showToast(labels.toastBatchFailed); return; }
      showToast(labels.toastZipGenerating);
      try {
        const zip = new JSZip();
        for (let r = 0; r < batchCsvData.length; r++) {
          const row = batchCsvData[r];
          const cloneDoc = structuredClone(doc);
          cloneDoc.pages.forEach(pg => pg.nodes.forEach(n => {
            if (n.props.text) {
              Object.keys(row).forEach(k => { n.props.text = n.props.text.replace(new RegExp(`\\{\\{${k}\\}\\}`, 'g'), row[k]); });
            }
          }));
          for (let i = 0; i < cloneDoc.pages.length; i++) {
            const pngBlob = await exportPageToPng(cloneDoc, cloneDoc.pages[i].id);
            zip.file(`row-${r + 1}-page-${i + 1}.png`, pngBlob);
          }
        }
        const content = await zip.generateAsync({ type: 'blob' });
        const url = URL.createObjectURL(content);
        const a = document.createElement('a'); a.href = url; a.download = `printforge-batch-${Date.now()}.zip`; a.click();
        URL.revokeObjectURL(url);
        showToast(labels.toastBatchDone);
      } catch { showToast(labels.toastBatchFailed); }
      el.batchModal.hidden = true;
    };

    /* ── History Timeline ── */
    function openHistory() {
      if (!el.historyPanel) return;
      el.historyPanel.hidden = false;
      renderHistory();
    }
    function renderHistory() {
      if (!el.historyList) return;
      el.historyList.innerHTML = undoStack.map((snap, i) => {
        const isCurrent = i === undoStack.length - 1;
        return `<button class="history-item${isCurrent ? ' active' : ''}" data-history-idx="${i}">Step ${i + 1}${isCurrent ? ' (current)' : ''} — ${snap.pages?.length || 0} pages</button>`;
      }).join('');
      el.historyList.querySelectorAll('.history-item').forEach(btn => {
        btn.onclick = () => {
          const idx = Number(btn.dataset.historyIdx);
          if (idx < 0 || idx >= undoStack.length) return;
          doc = structuredClone(undoStack[idx]);
          undoStack.length = idx + 1;
          redoStack.length = 0;
          setPrimarySelection(null);
          dirty = true; setSaveIndicator(); autosaveSchedule();
          render(); renderHistory();
        };
      });
    }
    if (el.historyClose) el.historyClose.onclick = () => { el.historyPanel.hidden = true; };

    /* ── Color Palette Generator ── */
    function hslToHex(h, s, l) {
      s /= 100; l /= 100;
      const a = s * Math.min(l, 1 - l);
      const f = n => { const k = (n + h / 30) % 12; const clr = l - a * Math.max(Math.min(k - 3, 9 - k, 1), -1); return Math.round(255 * clr).toString(16).padStart(2, '0'); };
      return `#${f(0)}${f(8)}${f(4)}`;
    }
    function hexToHsl(hex) {
      let r = parseInt(hex.slice(1, 3), 16) / 255, g = parseInt(hex.slice(3, 5), 16) / 255, b = parseInt(hex.slice(5, 7), 16) / 255;
      const max = Math.max(r, g, b), min = Math.min(r, g, b);
      let h = 0, s = 0, l = (max + min) / 2;
      if (max !== min) { const d = max - min; s = l > 0.5 ? d / (2 - max - min) : d / (max + min); if (max === r) h = ((g - b) / d + (g < b ? 6 : 0)) * 60; else if (max === g) h = ((b - r) / d + 2) * 60; else h = ((r - g) / d + 4) * 60; }
      return { h: Math.round(h), s: Math.round(s * 100), l: Math.round(l * 100) };
    }
    function generateColorPalette(baseHex, harmony) {
      const { h, s, l } = hexToHsl(baseHex || '#6366f1');
      if (harmony === 'complementary') return [baseHex, hslToHex((h + 180) % 360, s, l), hslToHex(h, s, Math.min(l + 20, 95)), hslToHex((h + 180) % 360, s, Math.min(l + 20, 95)), hslToHex(h, Math.max(s - 20, 10), l)];
      if (harmony === 'triadic') return [baseHex, hslToHex((h + 120) % 360, s, l), hslToHex((h + 240) % 360, s, l), hslToHex(h, s, Math.min(l + 25, 95)), hslToHex(h, Math.max(s - 30, 10), l)];
      return [baseHex, hslToHex((h + 30) % 360, s, l), hslToHex((h + 60) % 360, s, l), hslToHex((h - 30 + 360) % 360, s, l), hslToHex((h - 60 + 360) % 360, s, l)];
    }

    /* ── Ctrl+K shortcut for command palette ── */
    window.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (el.cmdPaletteOverlay && !el.cmdPaletteOverlay.hidden) closeCmdPalette(); else openCmdPalette();
      }
    });

    /* ── Favorites Bar ── */
    const FAV_KEY = 'printforge_favorites_v1';
    function loadFavorites() { try { return JSON.parse(localStorage.getItem(FAV_KEY) || '[]'); } catch { return []; } }
    function saveFavorites(favs) { localStorage.setItem(FAV_KEY, JSON.stringify(favs)); }
    function renderFavorites() {
      const favs = loadFavorites();
      if (!el.favoritesBar || !el.favoritesItems) return;
      el.favoritesBar.hidden = favs.length === 0;
      el.favoritesItems.innerHTML = favs.map(f => `<button class="fav-item" data-fav-block="${f}" draggable="true" title="${f}">${f}</button>`).join('');
      el.favoritesItems.querySelectorAll('.fav-item').forEach(btn => {
        btn.onclick = () => createPreset(btn.dataset.favBlock, 30, 60);
        btn.ondragstart = (e) => { draggingBlock = btn.dataset.favBlock; e.dataTransfer.setData('text/plain', btn.dataset.favBlock); };
        btn.oncontextmenu = (e) => { e.preventDefault(); const favs2 = loadFavorites().filter(x => x !== btn.dataset.favBlock); saveFavorites(favs2); renderFavorites(); };
      });
    }
    el.blockList?.querySelectorAll('.block-item').forEach(btn => {
      btn.addEventListener('contextmenu', (e) => {
        e.preventDefault();
        const blockType = btn.dataset.block;
        const favs = loadFavorites();
        if (favs.includes(blockType)) { saveFavorites(favs.filter(x => x !== blockType)); }
        else { favs.push(blockType); saveFavorites(favs); }
        renderFavorites();
      });
    });
    renderFavorites();

    /* ── Color Generator UI ── */
    if (el.colorGenBtn) el.colorGenBtn.onclick = () => {
      const base = el.colorGenBase?.value || '#6366f1';
      const harmony = el.colorGenHarmony?.value || 'analogous';
      const palette = generateColorPalette(base, harmony);
      if (el.colorGenSwatches) {
        el.colorGenSwatches.innerHTML = palette.map(c => `<button class="swatch" style="background:${c}" data-color="${c}" title="${c}"></button>`).join('');
        el.colorGenSwatches.querySelectorAll('.swatch').forEach(sw => {
          sw.onclick = () => { navigator.clipboard?.writeText(sw.dataset.color); showToast(labels.toastCopied); };
          sw.ondblclick = () => { doc.brandSwatches.push(sw.dataset.color); if (doc.brandSwatches.length > 8) doc.brandSwatches.shift(); commitChange(); render(); showToast(labels.saveToBrand); };
        });
