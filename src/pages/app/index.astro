    /* ── Print Profiles ── */
    const PRINT_PROFILES = {
      home: { dpi: 150, bleedMm: 0, cropMarks: false, info: 'Home printer: 150 DPI, no bleed' },
      office: { dpi: 300, bleedMm: 0, cropMarks: false, info: 'Office: 300 DPI, no bleed' },
