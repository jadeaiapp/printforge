      el.masterList.innerHTML = doc.masterNodes.map((n, i) => `<div class="master-item"><span>${n.name} (${n.type})</span><button class="btn" data-master-remove="${i}">×</button></div>`).join('');
      el.masterList.querySelectorAll('[data-master-remove]').forEach(btn => {
        btn.onclick = () => { const idx = Number(btn.dataset.masterRemove); doc.masterNodes.splice(idx, 1); commitChange(); render(); renderMasterList(); };
      });
    }
    if (el.masterAddBtn) el.masterAddBtn.onclick = () => {
      const sel = selectedNodes();
      if (!sel.length) return;
      if (!doc.masterNodes) doc.masterNodes = [];
      sel.forEach(n => doc.masterNodes.push(structuredClone(n)));
      commitChange(); render(); renderMasterList();
    };
    if (el.masterClearBtn) el.masterClearBtn.onclick = () => { doc.masterNodes = []; commitChange(); render(); renderMasterList(); };
    renderMasterList();

    /* ── Saved Components Library ── */
    function renderComponentList() {
      if (!el.componentList) return;
      if (!doc.savedComponents || !doc.savedComponents.length) { el.componentList.innerHTML = `<p class="theme-note">${labels.noComponents}</p>`; return; }
      el.componentList.innerHTML = doc.savedComponents.map((comp, i) => `<div class="component-item"><button class="btn" data-comp-insert="${i}">${comp.name} (${comp.nodes.length})</button><button class="btn" data-comp-remove="${i}">×</button></div>`).join('');
      el.componentList.querySelectorAll('[data-comp-insert]').forEach(btn => {
        btn.onclick = () => {
          const comp = doc.savedComponents[Number(btn.dataset.compInsert)];
          if (!comp) return;
          const p = activePage(); if (!p) return;
          const maxZ = p.nodes.reduce((m, n) => Math.max(m, n.z), 0);
          comp.nodes.forEach((n, i) => { const clone = structuredClone(n); clone.id = createId('node'); clone.z = maxZ + i + 1; clone.xMm += 5; clone.yMm += 5; p.nodes.push(clone); });
          commitChange(); render();
